                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar termvar, x, y , z, f  ::=
metavar semiringEl, r , s ::=
metavar type, T , S ::=
indexvar i , j ::=

grammar 
HoleProps :: 'hprops_' ::=
  | T
  | ( i , s )                ::  :: Struc      {{ com structure }}
  | hprops f                  ::  :: App        {{ com application }}

grammar
NatMap :: 'nm_' ::=
  | nm f                      ::  :: App        {{ com application }}

grammar
hexp :: 'e_' ::=
  | chunk r                   ::  :: Chunk
  | compose r x e             ::  :: Compose

terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile   {{ tex \vdash }}
  | chunk         ::  :: chunk
  | compose       ::  :: compose

formula :: formula_ ::=
|   judgement                 ::  :: judgement
|   formulai .. formulaj      ::  :: dots

defns

isChunk :: '' ::=

defn
x |- e ::  :: isChunk :: '' by

  ------------ :: Chunk
  x |- chunk t