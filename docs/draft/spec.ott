embed
  {{tex-preamble \usepackage{cmll}
                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar filling, f  ::=
metavar textlike, t ::=
metavar natural, n ::=
metavar hole, h ::=
indexvar i, j ::=

grammar 
HoleProps :: 'hprops_' ::=
  | ( n , nm )                ::  :: Struc      {{ com structure }}
  | h f                       ::  :: App        {{ com application }}

grammar
NatMap :: 'nm_' ::=
  | nm f                      ::  :: App        {{ com application }}

grammar
HoleyExp :: 'e_' ::=
  | chunk t                   ::  :: Chunk
  | compose t n e             ::  :: Compose

terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile   {{ tex \vdash }}

defns

identity :: '' ::=

defn
hprops |- chunk t ::  :: isChunk :: '' by

  ------------ :: Chunk
  hprops |- chunk t




