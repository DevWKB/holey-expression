embed
  {{tex-preamble \usepackage{cmll}
                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar termvar, x, f, m, s, t ::=
metavar monvar, m, id ::=
metavar type, T , S ::=
indexvar i , j ::=


grammar
hexp, e :: 'e_' ::=
  | chunk t                   ::  :: Chunk
  | compose t x e             ::  :: Compose
  | ( e )                     :: S :: Parens

holeprops, hp :: 'hprops_' ::=
  | ( xi .. xj , s )          ::  :: Struc      {{ com structure }}
  | hprops f                  ::  :: App        {{ com application }}

% Re-define hole as list
hole, h :: 'h_' ::=
  | ( i , hprops )            ::  :: Struc      {{ com structure }}

c :: 'c_' ::=                                   {{ com chunk subgrammar}}
  | chunk t                   ::  :: Chunk

terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile    {{ tex \vdash }}
  | chunk         ::  :: chunk        {{ tex \mathit{chunk} }}
  | compose       ::  :: compose      {{ tex \mathit{compose} }}
  | in            ::  :: elementOf    {{ tex \in }}
  | nin           ::  :: notIn        {{ tex \notin }}
  | and           ::  :: andSymbol    {{ tex \cap }}
  | !             ::  :: not          {{ tex \neg }}
  | \-/           ::  :: forall       {{ tex \forall }}

formula :: formula_ ::=
  | judgement                   ::   :: judgement
  | judgement1 && judgement2    ::   :: judgements
        {{ tex [[judgement1]] \land [[judgement2]] }}
  | formulai .. formulaj        ::   :: dots  
  | not ( formula )             :: M :: not
        {{ tex \neg [[formula]] }}
  | \-/ formula :               ::   :: forall
        {{ tex \forall [[formula]] : }}

subrules
  c <:: hexp


% Judgements on expressions
defns

HExp :: '' ::=

  defn
  isChunk e ::  :: isChunk :: '' {{ com HExp is a chunk }} by

    ----------------- :: Chunk
    isChunk (chunk t)

  defn
  hprops |- e ::  :: isComposed :: '' {{ com HExp is composed of text, an index, and a HExp }}  by

    % Change `isChunk e` to is c `t is chunk`
    % Prove this going up.
    
    -------------------------------- :: Compose
    hprops |- compose t x e

  
  
  defn
  null e ::   :: isNull :: '' {{ com HExp is null }} by

  hprops |- compose t x e  && isUnit 
  ----------- :: is_null
  null e

  defn
  isUnit m :: :: isUnit :: '' {{ com an element of a monoid is the unit }} by

    -------- :: is_unit
    isUnit m
    

% Judgements on holes
defns

holes :: '' ::=

  defn
  isHoleList h ::  :: isHoleList :: '' {{ com is a list of holes }} by

    --------------------- :: hole_list
    isHoleList h

  % Make the following forumulas
  defn
  i in ehls ::  :: emptyHole :: '' {{ com index of empty hole }} by

    isHoleList (i, hprops)
    ---------------------- :: empty_hole
    i in ehls

  defn
  i in fhls ::  :: filledHole :: '' {{ com index of filled hole }} by

    isHoleList (i, hprops)
    ---------------------- :: filled_hole
    i in fhls

  %----------------------------------------------------------------------------
  % Judgements of negation
  % May not be necessary if opting to use `not` operator with their non-negated counterparts
  defn
  i nin ehls ::  :: notEmptyHole :: '' {{ com index of non-empty hole }} by

    isHoleList (i, hprops)
    ---------------------- :: not_empty_hole
    i nin ehls

  defn
  i nin fhls ::  :: notFilledHole :: '' {{ com index of non-filled hole }} by

    isHoleList (i, hprops)
    ---------------------- :: not_filled_hole
    i nin fhls
  %----------------------------------------------------------------------------

  defn
  |h| > 0 ::  :: oneHoleMin :: '' {{ com at least one hole exists }} by

    ------- :: min_one_hole
    |h| > 0

  % Support judgement; mostly a workaround for a formula, need to replace------
  
  defn 
  \-/ i in h: ::  :: forall :: '' {{ com for all indices i in h }} by

    ----------- :: for_all
    \-/ i in h:

  % End of support judgments----------------------------------------------

  % Move rules below under single judgement
  defn
  (ehls, fhls) |- [i] ::  :: filledHoles :: '' {{ com list of filled hole indices }} by
 
    i nin ehls && i in fhls
    ----------------------- :: filled_list
    (ehls, fhls) |- [i]

  defn
  (ehls, fhls) |- h ::  :: singleEmptyHole :: '' {{ com singleton list containing empty hole }} by

  % PROSPECTIVE CHANGE: i is a valid empty or filled hole
  % ...|- use this to check that the rest of list is valid
    \-/ i in h: i in ehls && i nin fhls
    |h| > 0
    ----------------------------------- :: singleton_empty
    (ehls, fhls) |- h

    i nin ehls && i in fhls
    ----------------------- :: filled_list
    (ehls, fhls) |- [i]

  % Edit judgments above to accomodate the changes from Harley.
