embed
  {{tex-preamble \usepackage{cmll}
                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar termvar, x, y , z, f  ::=
metavar semiringEl, r , s ::=
metavar type, T , S ::=
indexvar i , j ::=


grammar
hexp, e :: 'e_' ::=
  | chunk r                   ::  :: Chunk
  | compose r x e             ::  :: Compose
  | ( e )                     :: S :: Parens

holeprops, hp :: 'hprops_' ::=
  | ( xi .. xj , s )          ::  :: Struc      {{ com structure }}
  | hprops f                  ::  :: App        {{ com application }}

hole, h :: 'h_' ::=
  | ( i , hprops )            ::  :: Struc      {{ com structure }}

% This is a comment
c :: 'c_' ::=                                   {{ com chunk subgrammar}}
  | chunk r                   ::  :: Chunk

terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile    {{ tex \vdash }}
  | chunk         ::  :: chunk        {{ tex \mathit{chunk} }}
  | compose       ::  :: compose      {{ tex \mathit{compose} }}
  | in            ::  :: elementOf    {{ tex \in }}
  | nin           ::  :: notIn        {{ tex \notin }}
  | and           ::  :: andSymbol    {{ tex \cap }}
  | !             ::  :: not          {{ tex \neg }}
  | \-/           ::  :: forall       {{ tex \forall }}

formula :: formula_ ::=
  | judgement                 ::   :: judgement
  | judgement1 && judgement2  ::   :: judgements
        {{ tex [[judgement1]] \land [[judgement2]] }}
  | formulai .. formulaj      ::   :: dots  
  | not ( formula )           :: M :: not
        {{ tex \neg [[formula]] }}
  | \-/ formula :             ::   :: forall
        {{ tex \forall [[formula]] : }}

subrules
  c <:: hexp

defns

isHExp :: '' ::=

  defn
  isChunk e ::  :: isChunk :: '' {{ com HExp is a chunk }} by

    ----------------- :: Chunk
    isChunk (chunk r)

  defn
  hprops |- e ::  :: isComposed :: '' {{ com HExp is composed of text, an index, and a HExp }}  by

    % Trying to use && here leads to multiple parses
    hprops |- e && isChunk e
    ------------------------ :: Compose
    hprops |- compose r x e

% holeOps definitions below
defns

holeOps :: '' ::=

  % Support judgements
  defn
  isHoleList h ::  :: isHoleList :: '' {{ com is a list of holes }} by

    --------------------- :: hole_list
    isHoleList h

  defn
  i in ehls ::  :: emptyIndex :: '' {{ com index of empty hole }} by

    isHoleList (i, hprops)
    ---------------------- :: empty
    i in ehls

  defn
  i nin ehls ::  :: notEmptyIndex :: '' {{ com index of non-empty hole }} by

    isHoleList (i, hprops)
    ---------------------- :: not_empty
    i nin ehls

  defn
  i in fhls ::  :: filledIndex :: '' {{ com index of filled hole }} by

    isHoleList (i, hprops)
    ---------------------- :: filled
    i in fhls

  defn
  i nin fhls ::  :: notFilledIndex :: '' {{ com index of non-filled hole }} by

    isHoleList (i, hprops)
    ---------------------- :: not_filled
    i nin fhls

  defn
  |h| > 0 ::  :: oneHoleMin :: '' {{ com at least one hole exists }} by

    ------- :: min_one_hole
    |h| > 0

  defn 
  \-/ i in h: ::  :: forall :: '' {{ com for all indices i in h }} by

    ----------- :: for_all
    \-/ i in h:

  % End of support judgments

  defn
  (ehls, fhls) |- [i] ::  :: filledHoles :: '' {{ com list of filled hole indices }} by

    
    i nin ehls && i in fhls
    ----------------------- :: filled_list
    (ehls, fhls) |- [i]

  defn
  (ehls, fhls) |- h ::  :: emptyHole :: '' {{ com singleton list containing empty hole }} by

    
    \-/ i in h: i in ehls && i nin fhls
    |h| > 0
    ----------------------------------- :: empty_hole
    (ehls, fhls) |- h
