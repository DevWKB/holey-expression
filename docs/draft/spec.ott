embed
  {{tex-preamble \usepackage{cmll}
                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar termvar, x, y , z, f  ::=
metavar semiringEl, r , s ::=
metavar type, T , S ::=
indexvar i , j ::=


grammar
hexp :: 'e_' ::=
  | chunk r                   ::  :: Chunk
  | compose r x e             ::  :: Compose

holeprops :: 'hprops_' ::=
  | ( xi .. xj , s )          ::  :: Struc      {{ com structure }}
  | hprops f                  ::  :: App        {{ com application }}

hole :: 'h_' ::=
  | ( i , hprops )            ::  :: Struc      {{ com structure }}

c :: 'c_' ::=
  | chunk r                   ::  :: Chunk


terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile    {{ tex \vdash }}
  | chunk         ::  :: chunk        {{ tex \mathit{chunk} }}
  | compose       ::  :: compose      {{ tex \mathit{compose} }}


formula :: formula_ ::=
|   judgement                 ::  :: judgement
|   formulai .. formulaj      ::  :: dots


subrules
  c <:: hexp

defns

isHExp :: '' ::=

  defn
  hprops |- chunk r ::  :: isChunk :: '' {{ com HExp is a chunk }} by

    ----------------- :: Chunk
    hprops |- chunk r