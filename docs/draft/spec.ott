embed
  {{tex-preamble \usepackage{cmll}
                 \usepackage{stmaryrd}
                 \usepackage{relsize} }}

metavar termvar, x, y , z, f  ::=
metavar semiringEl, r , s ::=
metavar type, T , S ::=
indexvar i , j ::=


grammar
hexp, e :: 'e_' ::=
  | chunk r                   ::  :: Chunk
  | compose r x e             ::  :: Compose
  | ( e )                     :: S :: Parens

holeprops :: 'hprops_' ::=
  | ( xi .. xj , s )          ::  :: Struc      {{ com structure }}
  | hprops f                  ::  :: App        {{ com application }}

hole :: 'h_' ::=
  | ( i , hprops )            ::  :: Struc      {{ com structure }}

% This is a comment
c :: 'c_' ::=
  | chunk r                   ::  :: Chunk

terminals :: 'terminals_' ::=
  | |-            ::  :: turnstile    {{ tex \vdash }}
  | chunk         ::  :: chunk        {{ tex \mathit{chunk} }}
  | compose       ::  :: compose      {{ tex \mathit{compose} }}

formula :: formula_ ::=
  | judgement                 ::  :: judgement
  | formulai .. formulaj      ::  :: dots
  | formula1 && formula2      ::  :: formulas

subrules
  c <:: hexp

defns

isHExp :: '' ::=

  defn
  isChunk e ::  :: isChunk :: '' {{ com HExp is a chunk }} by

    ----------------- :: Chunk
    isChunk (chunk r)

  defn
  hprops |- e ::  :: isComposed :: '' by

    hprops |- e && isChunk e
    ------------------------ :: Compose
    hprops |- compose r x e
